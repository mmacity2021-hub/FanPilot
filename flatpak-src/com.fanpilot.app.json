{
  "app-id": "com.fanpilot.app",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.node20"
  ],
  "command": "fan-control",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=host",
    "--talk-name=org.freedesktop.systemd1",
    "--talk-name=org.freedesktop.Flatpak",
    "--talk-name=org.kde.StatusNotifierWatcher",
    "--talk-name=org.freedesktop.Notifications"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/node20/bin",
    "env": {
      "CARGO_HOME": "/run/build/fan-control/cargo"
    },
    "build-args": [
      "--share=network"
    ]
  },
  "modules": [
    "shared-modules/libayatana-appindicator/libayatana-appindicator-gtk3.json",
    {
      "name": "fan-control",
      "buildsystem": "simple",
      "build-commands": [
        "npm install",
        "npm run tauri build -- --no-bundle",
        "mkdir -p /app/bin",
        "cp src-tauri/target/release/fan-control /app/bin/",
        "mkdir -p /app/share/applications",
        "mkdir -p /app/share/icons/hicolor/128x128/apps",
        "cp src-tauri/icons/128x128.png /app/share/icons/hicolor/128x128/apps/com.fanpilot.app.png",
        "cat > /app/share/applications/com.fanpilot.app.desktop <<EOF\n[Desktop Entry]\nName=FanPilot\nComment=Contr\u00f4le des ventilateurs pour Mac sous Linux\nExec=fan-control\nIcon=com.fanpilot.app\nTerminal=false\nType=Application\nCategories=Utility;System;\nEOF"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../fan-control"
        }
      ]
    }
  ]
}